{
  "name": "smithandwillis",
  "type": "module",
  "private": true,
  "scripts": {
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "sb:components": "storyblok components pull --space 332344",
    "sb:types": "storyblok types generate --space 332344 --strict",
    "dev": "npm run sb:components && npm run sb:types && nuxt dev --host",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'"
  },
  "dependencies": {
    "@ditta/colophon": "^0.0.5",
    "@storyblok/nuxt": "^11.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "keen-slider": "^6.8.6",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "postcss-nested": "^8.0.1",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/sitemap": "^8.3.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.1",
    "sharp": "^0.35.3",
    "storyblok": "4.22.0",
    "typescript": "^6.0.3",
    "vite-svg-loader": "^5.1.1"
  },
  "overrides": {
    "zod": "^4.4.3"
  }
}
